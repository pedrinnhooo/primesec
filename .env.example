# Contact form → Resend → priimesec@gmail.com
# Get a key at https://resend.com/api-keys
NUXT_RESEND_API_KEY=
# Defaults to priimesec@gmail.com when empty
NUXT_CONTACT_TO_EMAIL=priimesec@gmail.com
# Prod: use a verified domain sender, e.g. PrimeSec <contato@primesec.com.br>
# Dev: leave empty to use Resend onboarding@resend.dev
NUXT_CONTACT_FROM_EMAIL=
# Min 16 chars — required in production
NUXT_CONTACT_HMAC_SECRET=
